<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>3D Flight Simulator</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            overflow: hidden;
            width: 100%;
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
            -webkit-user-select: none;
            background-color: #000;
        }
        #canvas-container {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        /* UI Overlays */
        .ui-panel {
            position: absolute;
            z-index: 10;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
            pointer-events: none;
        }
        #hud-top {
            top: 15px;
            left: 15px;
            font-size: 18px;
            font-weight: bold;
            background: rgba(0, 0, 0, 0.4);
            padding: 10px 15px;
            border-radius: 8px;
            border-left: 4px solid #00ffcc;
        }
        #hud-center-msg {
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 28px;
            font-weight: bold;
            text-align: center;
            color: #ffff00;
            display: none;
            background: rgba(0, 0, 0, 0.6);
            padding: 15px 30px;
            border-radius: 10px;
            animation: pulse 1.5s infinite;
        }
        @keyframes pulse {
            0% { transform: translate(-50%, -50%) scale(1); }
            50% { transform: translate(-50%, -50%) scale(1.05); }
            100% { transform: translate(-50%, -50%) scale(1); }
        }
        /* Mobile Touch Controls */
        .touch-container {
            position: absolute;
            bottom: 20px;
            z-index: 20;
            display: flex;
            justify-content: space-between;
            width: 100%;
            padding: 0 20px;
            box-sizing: border-box;
            pointer-events: none;
        }
        .control-group {
            display: flex;
            gap: 15px;
            pointer-events: auto;
        }
        .btn-touch {
            width: 70px;
            height: 70px;
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.6);
            border-radius: 50%;
            color: white;
            font-size: 24px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
            touch-action: manipulation;
        }
        .btn-touch:active {
            background: rgba(0, 255, 200, 0.5);
            border-color: #00ffcc;
            transform: scale(0.95);
        }
        .vertical-controls {
            flex-direction: column;
        }
        .throttle-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: rgba(0,0,0,0.5);
            padding: 10px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.2);
        }
        .throttle-label {
            color: white;
            font-size: 12px;
            margin-bottom: 5px;
            font-weight: bold;
        }
        /* Main Menu / Shop Overlay */
        #menu-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(15,32,67,0.95) 0%, rgba(27,49,85,0.95) 100%);
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: white;
            padding: 20px;
            box-sizing: border-box;
        }
        #menu-overlay h1 {
            margin-top: 0;
            margin-bottom: 5px;
            font-size: 32px;
            letter-spacing: 2px;
            color: #00ffcc;
            text-shadow: 0 0 10px rgba(0,255,200,0.5);
            text-align: center;
        }
        #menu-overlay p {
            margin-bottom: 20px;
            color: #a0aec0;
            text-align: center;
        }
        .shop-container {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            width: 100%;
            max-width: 900px;
            padding: 15px 5px;
            margin-bottom: 20px;
            scrollbar-width: thin;
        }
        .shop-item {
            flex: 0 0 220px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .shop-item.selected {
            border-color: #00ffcc;
            background: rgba(0, 255, 200, 0.1);
            box-shadow: 0 0 15px rgba(0,255,200,0.3);
        }
        .shop-item h3 {
            margin: 0 0 10px 0;
            font-size: 18px;
        }
        .stats-bar {
            background: rgba(255,255,255,0.1);
            height: 6px;
            border-radius: 3px;
            margin: 8px 0;
            overflow: hidden;
            text-align: left;
        }
        .stats-fill {
            height: 100%;
            background: #00ffcc;
        }
        .shop-btn {
            background: #00ffcc;
            color: #0f2043;
            border: none;
            padding: 10px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            width: 100%;
        }
        .shop-btn.locked {
            background: #e53e3e;
            color: white;
        }
        .shop-btn.owned {
            background: #4a5568;
            color: #cbd5e0;
        }
        .mission-selector {
            width: 100%;
            max-width: 500px;
            background: rgba(0,0,0,0.3);
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 25px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .mission-selector label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #00ffcc;
        }
        .mission-selector select {
            width: 100%;
            padding: 10px;
            background: #1a202c;
            color: white;
            border: 1px solid #4a5568;
            border-radius: 6px;
            font-size: 16px;
            outline: none;
        }
        #start-btn {
            background: linear-gradient(90deg, #00ffcc, #00bfff);
            color: #0f2043;
            font-size: 22px;
            font-weight: bold;
            padding: 15px 60px;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,255,200,0.4);
            transition: transform 0.2s;
        }
        #start-btn:active {
            transform: scale(0.95);
        }
        #credits-display {
            font-size: 20px;
            color: #ffff00;
            font-weight: bold;
            margin-bottom: 15px;
            background: rgba(0,0,0,0.3);
            padding: 5px 15px;
            border-radius: 20px;
        }
    </style>
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <!-- Main Game Canvas Container -->
    <div id="canvas-container"></div>

    <!-- HUD Overlay -->
    <div id="hud-top" class="ui-panel">
        Flugzeug: <span id="hud-plane-name">-</span><br>
        Credits: <span id="hud-credits" style="color: #ffff00;">0</span><br>
        Geschwindigkeit: <span id="hud-speed">0</span> km/h (Schub: <span id="hud-throttle">0</span>%)<br>
        Höhe: <span id="hud-altitude">0</span> m<br>
        <span id="hud-mission-desc" style="color: #00ffcc; font-size: 15px;">Mission: Fliege durch den Ring!</span>
    </div>

    <div id="hud-center-msg" class="ui-panel">MISSION ERFÜLLT!<br>+50 Credits</div>

    <!-- Touch Controls for Android -->
    <div class="touch-container">
        <!-- Left Side: Throttle and Roll -->
        <div class="control-group">
            <div class="throttle-container">
                <span class="throttle-label">SCHUB</span>
                <button class="btn-touch" id="btn-throttle-up">▲</button>
                <div style="height: 10px;"></div>
                <button class="btn-touch" id="btn-throttle-down">▼</button>
            </div>
            <div class="vertical-controls" style="display: flex; flex-direction: row; align-items: center; gap: 10px;">
                <button class="btn-touch" id="btn-roll-left">◀</button>
                <button class="btn-touch" id="btn-roll-right">▶</button>
            </div>
        </div>
        
        <!-- Right Side: Pitch (Höhenruder) -->
        <div class="control-group vertical-controls" style="justify-content: center;">
            <button class="btn-touch" id="btn-pitch-down">▲</button>
            <div style="height: 15px; text-align: center; color: rgba(255,255,255,0.4); font-size: 12px; font-weight: bold;">PITCH</div>
            <button class="btn-touch" id="btn-pitch-up">▼</button>
        </div>
    </div>

    <!-- Main Menu & Shop Overlay -->
    <div id="menu-overlay">
        <h1>TURBOPROP FLIGHT SIMULATOR</h1>
        <p>HTML5 Android Prototyp (20 Missionen & 10 Flugzeuge)</p>
        
        <div id="credits-display">Deine Credits: <span id="menu-credits">0</span> 🪙</div>

        <!-- Aircraft Shop -->
        <div class="shop-container" id="shop-list">
            <!-- Dynamically populated via JS -->
        </div>

        <!-- Mission Selector -->
        <div class="mission-selector">
            <label for="mission-select">Mission auswählen (1-20):</label>
            <select id="mission-select">
                <!-- Dynamically populated via JS -->
            </select>
        </div>

        <button id="start-btn">FLUG STARTEN</button>
    </div>

    <script>
        // --- GAME STATE ---
        let saveState = {
            credits: 0,
            unlockedAircraft: [0], // Index of unlocked planes
            selectedAircraft: 0,
            currentMission: 0
        };

        // Load SaveState from LocalStorage if available
        if(localStorage.getItem('turboprop_sim_save')) {
            try {
                saveState = JSON.parse(localStorage.getItem('turboprop_sim_save'));
            } catch(e) { console.error(e); }
        }

        function saveGame() {
            localStorage.setItem('turboprop_sim_save', JSON.stringify(saveState));
        }

        // --- DATA DEFS: 10 AIRCRAFT ---
        const aircraftData = [
            { name: "Cessna Trainer", price: 0, speedMax: 40, handling: 1.5, liftFactor: 0.12, color: 0xffffff, desc: "Perfekt für Einsteiger." },
            { name: "Twin Turboprop", price: 50, speedMax: 55, handling: 1.1, liftFactor: 0.15, color: 0x3182ce, desc: "Klassisches Regional-Frachtflugzeug." },
            { name: "C-130 Hercules", price: 120, speedMax: 50, handling: 0.8, liftFactor: 0.20, color: 0x4a5568, desc: "Schweres, vierpropelleriges Militärflugzeug." },
            { name: "Water Bomber", price: 200, speedMax: 52, handling: 1.0, liftFactor: 0.18, color: 0xdd6b20, desc: "Löschflugzeug für Spezialeinsätze." },
            { name: "Regional Airliner", price: 350, speedMax: 65, handling: 0.9, liftFactor: 0.16, color: 0xe2e8f0, desc: "Ziviles Passagierflugzeug." },
            { name: "Military Cargo Jet", price: 500, speedMax: 75, handling: 0.7, liftFactor: 0.22, color: 0x2d3748, desc: "Überschall-Frachttransporter." },
            { name: "Supersonic Interceptor", price: 750, speedMax: 110, handling: 2.0, liftFactor: 0.10, color: 0xe53e3e, desc: "Extrem schnell und wendig." },
            { name: "Concept VTOL X", price: 1000, speedMax: 85, handling: 1.8, liftFactor: 0.25, color: 0x805ad5, desc: "Zukunftsweisendes Hybridflugzeug." },
            { name: "Heavy Cargo Titan", price: 1500, speedMax: 60, handling: 0.5, liftFactor: 0.30, color: 0x234e52, desc: "Das größte Flugzeug der Flotte." },
            { name: "Stealth Ghost Jet", price: 2500, speedMax: 120, handling: 2.2, liftFactor: 0.14, color: 0x1a202c, desc: "Das ultimative High-End Flugzeug." }
        ];

        // --- DATA DEFS: 20 MISSIONS ---
        const missionData = [];
        // Programmatically generate 20 missions tracking rings or points spread across the environment
        for (let i = 1; i <= 20; i++) {
            missionData.push({
                id: i - 1,
                name: `Mission ${i}: ` + (
                    i === 1 ? "Erster Start" :
                    i <= 5 ? "Höhentraining" :
                    i <= 10 ? "Präzisionsflug" :
                    i <= 15 ? "Schwerer Navigationkurs" : "Extremes Manöver"
                ),
                // Varying coordinates for waypoint rings
                targetPos: {
                    x: Math.sin(i * 1.5) * (200 + i * 50),
                    y: 40 + (i * 12) + Math.cos(i) * 20,
                    z: -300 - (i * 180)
                },
                reward: 30 + (i * 20),
                desc: `Fliege präzise durch den markierten Kontrollring am Himmel.`
            });
        }

        // --- THREE.JS GRAPHICS & PHYSICS ENGINE VARIABLES ---
        let scene, camera, renderer;
        let airplane, propellerLeft, propellerRight;
        let ringTarget;
        let clock = new THREE.Clock();

        // Flight Physics States
        let physics = {
            speed: 0,
            throttle: 0, // 0 to 100
            pitchSpeed: 0,
            rollSpeed: 0,
            yawSpeed: 0,
            altitude: 0,
            velocity: new THREE.Vector3(0,0,0),
            orientation: new THREE.Quaternion()
        };

        // Inputs State (Keyboard + Touch)
        let inputs = {
            pitchUp: false, pitchDown: false,
            rollLeft: false, rollRight: false,
            throttleUp: false, throttleDown: false
        };

        // --- INITIALIZE UI (SHOP & MISSIONS) ---
        const shopListEl = document.getElementById('shop-list');
        const missionSelectEl = document.getElementById('mission-select');
        const menuOverlay = document.getElementById('menu-overlay');

        function updateUI() {
            document.getElementById('menu-credits').innerText = saveState.credits;
            document.getElementById('hud-credits').innerText = saveState.credits;
            
            // Build Shop Items
            shopListEl.innerHTML = '';
            aircraftData.forEach((ac, idx) => {
                const isUnlocked = saveState.unlockedAircraft.includes(idx);
                const isSelected = saveState.selectedAircraft === idx;
                
                const item = document.createElement('div');
                item.className = `shop-item ${isSelected ? 'selected' : ''}`;
                
                // Calculate stat percentages for visualization
                const speedPct = (ac.speedMax / 120) * 100;
                const handPct = (ac.handling / 2.5) * 100;

                item.innerHTML = `
                    <div>
                        <h3>${ac.name}</h3>
                        <p style="font-size:11px; color:#a0aec0; margin:0 0 10px 0;">${ac.desc}</p>
                        <div style="font-size:11px; text-align:left;">SPEED (${ac.speedMax * 8} km/h)</div>
                        <div class="stats-bar"><div class="stats-fill" style="width: ${speedPct}%"></div></div>
                        <div style="font-size:11px; text-align:left;">HANDLING</div>
                        <div class="stats-bar"><div class="stats-fill" style="width: ${handPct}%; background:#00bfff;"></div></div>
                    </div>
                    <div>
                        ${isUnlocked ? 
                            `<button class="shop-btn ${isSelected?'':'owned'}" onclick="selectAircraft(${idx})">${isSelected?'Ausgewählt':'Wählen'}</button>` : 
                            `<button class="shop-btn locked" onclick="buyAircraft(${idx})">Kaufen: ${ac.price} C</button>`
                        }
                    </div>
                `;
                shopListEl.appendChild(item);
            });

            // Build Mission Options
            missionSelectEl.innerHTML = '';
            missionData.forEach((m) => {
                const opt = document.createElement('option');
                opt.value = m.id;
                opt.selected = saveState.currentMission === m.id;
                opt.innerText = `${m.name} (+${m.reward} Credits)`;
                missionSelectEl.appendChild(opt);
            });
        }

        window.selectAircraft = function(idx) {
            saveState.selectedAircraft = idx;
            saveGame();
            updateUI();
        };

        window.buyAircraft = function(idx) {
            const price = aircraftData[idx].price;
            if(saveState.credits >= price) {
                saveState.credits -= price;
                saveState.unlockedAircraft.push(idx);
                saveState.selectedAircraft = idx;
                saveGame();
                updateUI();
            } else {
                alert("Nicht genug Credits! Fliege erst Missionen, um Credits zu verdienen.");
            }
        };

        // --- INITIALIZE 3D ENVIRONMENT ---
        function init3D() {
            const container = document.getElementById('canvas-container');
            container.innerHTML = ''; // Clear prior instances
            
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x87ceeb); // Beautiful Sky Blue
            scene.fog = new THREE.FogExp2(0x87ceeb, 0.0015);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 5000);
            
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            container.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const sunLight = new THREE.DirectionalLight(0xfffaed, 0.8);
            sunLight.position.set(500, 1000, 500);
            scene.add(sunLight);

            // Infinite Floor / Ground Grid
            const groundGeo = new THREE.PlaneGeometry(10000, 10000, 32, 32);
            // Simple grid/checker terrain look
            const groundMat = new THREE.MeshStandardMaterial({ 
                color: 0x557a46, 
                roughness: 0.9, 
                metalness: 0.1,
                flatShading: true
            });
            const ground = new THREE.Mesh(groundGeo, groundMat);
            ground.rotation.x = -Math.PI / 2;
            scene.add(ground);

            // Add simple runway/airport
            const runwayGeo = new THREE.PlaneGeometry(60, 800);
            const runwayMat = new THREE.MeshStandardMaterial({ color: 0x333333, roughness: 0.8 });
            const runway = new THREE.Mesh(runwayGeo, runwayMat);
            runway.rotation.x = -Math.PI / 2;
            runway.position.set(0, 0.1, -250);
            scene.add(runway);

            // Runway markings
            const lineGeo = new THREE.PlaneGeometry(2, 40);
            const lineMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
            for(let z = -600; z <= 100; z += 100) {
                const line = new THREE.Mesh(lineGeo, lineMat);
                line.rotation.x = -Math.PI / 2;
                line.position.set(0, 0.2, z);
                scene.add(line);
            }

            // Build Selected Airplane Model dynamically
            buildAirplaneModel();

            // Build Mission Waypoint Target Ring
            buildMissionRing();

            // Reset Physics State based on selection
            const ac = aircraftData[saveState.selectedAircraft];
            physics.speed = 0;
            physics.throttle = 0;
            airplane.position.set(0, 2, 0); // Position exactly at start of runway
            airplane.rotation.set(0, Math.PI, 0); // Facing down the runway forward (towards negative Z)

            window.addEventListener('resize', onWindowResize, false);
        }

        function buildAirplaneModel() {
            const ac = aircraftData[saveState.selectedAircraft];
            
            // Assembly Group
            airplane = new THREE.Group();

            // Fuselage (Rumpf)
            const bodyGeo = new THREE.CylinderGeometry(1.2, 0.8, 8, 8);
            bodyGeo.rotateX(Math.PI / 2);
            const bodyMat = new THREE.MeshStandardMaterial({ color: ac.color, roughness: 0.4 });
            const fuselage = new THREE.Mesh(bodyGeo, bodyMat);
            airplane.add(fuselage);

            // Cockpit Window
            const glassGeo = new THREE.BoxGeometry(1.4, 0.8, 1.5);
            const glassMat = new THREE.MeshStandardMaterial({ color: 0x00dfff, transparent: true, opacity: 0.6 });
            const cockpit = new THREE.Mesh(glassGeo, glassMat);
            cockpit.position.set(0, 0.6, -1.8);
            airplane.add(cockpit);

            // Wings (Hauptflügel) - Turboprop-Stil oben oder mittig montiert
            const wingGeo = new THREE.BoxGeometry(16, 0.2, 2.2);
            const wing = new THREE.Mesh(wingGeo, bodyMat);
            wing.position.set(0, 0.5, -0.5);
            airplane.add(wing);

            // Tail Wings (Höhen- und Seitenruder)
            const tailHGeo = new THREE.BoxGeometry(5, 0.1, 1.2);
            const tailH = new THREE.Mesh(tailHGeo, bodyMat);
            tailH.position.set(0, 0.3, 3.2);
            airplane.add(tailH);

            const tailVGeo = new THREE.BoxGeometry(0.1, 2.2, 1.5);
            tailVGeo.rotateX(Math.PI / 6); // slightly swept back
            const tailV = new THREE.Mesh(tailVGeo, bodyMat);
            tailV.position.set(0, 1.2, 3.2);
            airplane.add(tailV);

            // 2 Turboprop Engines + Propellers (Left & Right on Wings)
            const engineGeo = new THREE.CylinderGeometry(0.5, 0.4, 2, 8);
            engineGeo.rotateX(Math.PI / 2);
            const engineMat = new THREE.MeshStandardMaterial({ color: 0x222222 });
            
            const engLeft = new THREE.Mesh(engineGeo, engineMat);
            engLeft.position.set(-4, 0.4, -1);
            airplane.add(engLeft);

            const engRight = engLeft.clone();
            engRight.position.x = 4;
            airplane.add(engRight);

            // Actual Propeller Blades
            const propGeo = new THREE.BoxGeometry(2.8, 0.2, 0.05);
            const propMat = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.8 });
            
            propellerLeft = new THREE.Mesh(propGeo, propMat);
            propellerLeft.position.set(-4, 0.4, -2.05);
            airplane.add(propellerLeft);

            propellerRight = propellerLeft.clone();
            propellerRight.position.x = 4;
            airplane.add(propellerRight);

            scene.add(airplane);
            document.getElementById('hud-plane-name').innerText = ac.name;
        }

        function buildMissionRing() {
            if(ringTarget) scene.remove(ringTarget);

            const m = missionData[saveState.currentMission];
            
            // Visual Ring Torus Geometry
            const ringGeo = new THREE.TorusGeometry(12, 1.5, 8, 24);
            const ringMat = new THREE.MeshBasicMaterial({ color: 0xffff00, wireframe: false });
            ringTarget = new THREE.Mesh(ringGeo, ringMat);
            
            // Set mission position
            ringTarget.position.set(m.targetPos.x, m.targetPos.y, m.targetPos.z);
            scene.add(ringTarget);

            document.getElementById('hud-mission-desc').innerText = `Ziel: ${m.name} - ${m.desc}`;
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // --- DETAILED REALISTIC FLIGHT PHYSICS ENGINE ---
        function updateFlightPhysics(delta) {
            if (!airplane) return;

            const ac = aircraftData[saveState.selectedAircraft];

            // 1. Throttle / Schubkraft berechnen
            if (inputs.throttleUp) physics.throttle = Math.min(100, physics.throttle + delta * 35);
            if (inputs.throttleDown) physics.throttle = Math.max(0, physics.throttle - delta * 35);
            document.getElementById('hud-throttle').innerText = Math.round(physics.throttle);

            // Propeller-Animation proportional zum Schub rotieren lassen
            if(propellerLeft && propellerRight) {
                const rotationSpeed = (physics.throttle / 100) * 1.5 + 0.1;
                propellerLeft.rotation.z += rotationSpeed;
                propellerRight.rotation.z -= rotationSpeed;
            }

            // Zielgeschwindigkeit basierend auf Schubkraft berechnen
            let targetSpeed = (physics.throttle / 100) * ac.speedMax;
            
            // Gravitationseinfluss auf die Fluggeschwindigkeit (Sturzflug beschleunigt, Steigflug bremst)
            // Extraktion des Vorwärts-Vektors des Flugzeugs
            const forwardVector = new THREE.Vector3(0, 0, -1).applyQuaternion(airplane.quaternion);
            const pitchInclination = forwardVector.y; // -1 ist senkrecht nach unten, +1 senkrecht nach oben
            
            targetSpeed -= pitchInclination * 15; // Schwerkraft-Modifikator für Geschwindigkeit
            if (targetSpeed < 0) targetSpeed = 0;

            // Sanfte Geschwindigkeitsanpassung (Trägheit der Masse)
            physics.speed += (targetSpeed - physics.speed) * delta * 1.2;

            // 2. Auftrieb (Lift) berechnen
            // Auftrieb hängt quadratisch von der Geschwindigkeit ab und dem Anstellwinkel
            let lift = (physics.speed * physics.speed) * ac.liftFactor * 0.05;
            const gravity = 9.81 * 0.15; // Skalierte Erdanziehungskraft

            // 3. Rotationen / Steuerung (Pitch & Roll) einrechnen
            const handlingFactor = ac.handling;
            
            if (inputs.pitchUp) {
                physics.pitchSpeed = Math.min(1.2, physics.pitchSpeed + delta * 4 * handlingFactor);
            } else if (inputs.pitchDown) {
                physics.pitchSpeed = Math.max(-1.2, physics.pitchSpeed - delta * 4 * handlingFactor);
            } else {
                physics.pitchSpeed *= 0.9; // Automatische Stabilisierung Rückstellung
            }

            if (inputs.rollLeft) {
                physics.rollSpeed = Math.min(1.5, physics.rollSpeed + delta * 5 * handlingFactor);
            } else if (inputs.rollRight) {
                physics.rollSpeed = Math.max(-1.5, physics.rollSpeed - delta * 5 * handlingFactor);
            } else {
                physics.rollSpeed *= 0.9; // Roll-Dämpfung
            }

            // Lokale Rotationen auf das Flugzeug-Quat anwenden
            airplane.rotateX(physics.pitchSpeed * delta);
            airplane.rotateZ(physics.rollSpeed * delta);

            // Aerodynamische Eigenstabilität: Rollen erzeugt leichtes Gieren (Yaw / Kurvenflug)
            // Auslesen der z-Rotation aus der Flugzeugmatrix, um Kurven durch Neigen einzuleiten
            const euler = new THREE.Euler().setFromQuaternion(airplane.quaternion, 'YXZ');
            const rollAngle = euler.z;
            airplane.rotateY(-rollAngle * delta * 0.4);

            // 4. Bewegung im Raum berechnen (Vorwärtsbewegung + Auftrieb vs Gravitation)
            // Flugzeug bewegt sich immer primär in seine lokale Vorwärtsrichtung (-Z)
            let localVelocity = new THREE.Vector3(0, 0, -physics.speed);
            localVelocity.applyQuaternion(airplane.quaternion);

            // Vertikale Differenz aus Auftrieb minus Schwerkraft dazurechnen
            let verticalNetChange = lift - gravity;
            
            // Wenn das Flugzeug am Boden steht, kann es nicht versinken
            if (airplane.position.y <= 1.2 && verticalNetChange < 0) {
                verticalNetChange = 0;
                // Am Boden rollt das Flugzeug flach auf der Landebahn (Rollen ausgleichen)
                if(physics.speed < 5) {
                    airplane.rotation.z *= 0.8;
                    airplane.rotation.x *= 0.8;
                }
            }

            // Update Positionskoordinaten
            airplane.position.x += localVelocity.x * delta * 10;
            airplane.position.y += (localVelocity.y + verticalNetChange) * delta * 10;
            airplane.position.z += localVelocity.z * delta * 10;

            // Bodenkollisionsschutz (Mindesthöhe)
            if (airplane.position.y < 1.2) {
                airplane.position.y = 1.2;
                // Strömungsabriss/Crash verhindern bei sanfter Landung, sonst Speed-Abnahme durch Reibung
                if(physics.throttle === 0) {
                    physics.speed *= 0.95;
                }
            }

            // HUD UI Werte aktualisieren
            document.getElementById('hud-speed').innerText = Math.round(physics.speed * 8);
            document.getElementById('hud-altitude').innerText = Math.round(airplane.position.y * 5);
            
            // Rotieren des Missionsringes für bessere visuelle Auffälligkeit
            if(ringTarget) {
                ringTarget.rotation.y += delta * 0.5;
            }

            // 5. Verfolgungskamera (Chase Cam) perfekt ausrichten
            // Positioniert sich elegant versetzt hinter dem Flugzeug
            const offset = new THREE.Vector3(0, 3.5, 12);
            offset.applyQuaternion(airplane.quaternion);
            
            const targetCamPos = airplane.position.clone().add(offset);
            camera.position.lerp(targetCamPos, 0.1); // Weicher Kameraübergang (Lerp)
            camera.lookAt(airplane.position.clone().add(new THREE.Vector3(0, 0.5, -2).applyQuaternion(airplane.quaternion)));

            // 6. Kollisionsabfrage mit dem Missionsziel-Ring
            checkMissionCollision();
        }

        function checkMissionCollision() {
            if (!airplane || !ringTarget) return;

            const dist = airplane.position.distanceTo(ringTarget.position);
            
            // Erfassungsradius des Rings (Torus-Größe beträgt ca. 12 Einheiten)
            if (dist < 15) {
                const m = missionData[saveState.currentMission];
                
                // Belohnung vergeben
                saveState.credits += m.reward;
                
                // Visuelles Feedback einblenden
                const msg = document.getElementById('hud-center-msg');
                msg.innerHTML = `MISSION ERFÜLLT!<br>+${m.reward} Credits`;
                msg.style.display = 'block';
                
                // Nächste Mission vorbereiten / freischalten
                saveState.currentMission = (saveState.currentMission + 1) % 20;
                
                saveGame();
                updateUI();

                // Ring kurzfristig ausblenden, an neuer Missionsposition respawnen lassen
                scene.remove(ringTarget);
                ringTarget = null;

                setTimeout(() => {
                    msg.style.display = 'none';
                    buildMissionRing();
                }, 3000);
            }
        }

        // --- GAME LOOP ---
        let gameRunning = false;
        function animate() {
            if (!gameRunning) return;
            
            requestAnimationFrame(animate);
            
            const delta = clock.getDelta();
            updateFlightPhysics(delta);
            
            renderer.render(scene, camera);
        }

        // --- INPUT BINDINGS (KEYBOARD + MOBILE TOUCH) ---
        // Setup Keyboard listeners
        window.addEventListener('keydown', (e) => {
            if(!gameRunning) return;
            switch(e.key.toLowerCase()) {
                case 'w': case 'arrowup': inputs.pitchUp = true; break;
                case 's': case 'arrowdown': inputs.pitchDown = true; break;
                case 'a': case 'arrowleft': inputs.rollLeft = true; break;
                case 'd': case 'arrowright': inputs.rollRight = true; break;
                case 'r': inputs.throttleUp = true; break;
                case 'f': inputs.throttleDown = true; break;
                case 'escape': 
                    // Zurück zum Hauptmenü
                    gameRunning = false;
                    menuOverlay.style.display = 'flex';
                    updateUI();
                    break;
            }
        });

        window.addEventListener('keyup', (e) => {
            switch(e.key.toLowerCase()) {
                case 'w': case 'arrowup': inputs.pitchUp = false; break;
                case 's': case 'arrowdown': inputs.pitchDown = false; break;
                case 'a': case 'arrowleft': inputs.rollLeft = false; break;
                case 'd': case 'arrowright': inputs.rollRight = false; break;
                case 'r': inputs.throttleUp = false; break;
                case 'f': inputs.throttleDown = false; break;
            }
        });

        // Setup Mobile Touch Button Helper Function
        function bindTouchBtn(elementId, inputProperty) {
            const btn = document.getElementById(elementId);
            if(!btn) return;
            
            const startHandler = (e) => {
                e.preventDefault();
                inputs[inputProperty] = true;
            };
            const endHandler = (e) => {
                e.preventDefault();
                inputs[inputProperty] = false;
            };

            btn.addEventListener('touchstart', startHandler, {passive: false});
            btn.addEventListener('touchend', endHandler, {passive: false});
            btn.addEventListener('touchcancel', endHandler, {passive: false});
            
            // Fallback for Desktop-Testing with mouse clicks on touch items
            btn.addEventListener('mousedown', () => { inputs[inputProperty] = true; });
            btn.addEventListener('mouseup', () => { inputs[inputProperty] = false; });
            btn.addEventListener('mouseleave', () => { inputs[inputProperty] = false; });
        }

        bindTouchBtn('btn-throttle-up', 'throttleUp');
        bindTouchBtn('btn-throttle-down', 'throttleDown');
        bindTouchBtn('btn-roll-left', 'rollLeft');
        bindTouchBtn('btn-roll-right', 'rollRight');
        bindTouchBtn('btn-pitch-up', 'pitchUp');
        bindTouchBtn('btn-pitch-down', 'pitchDown');

        // --- APPLICATION START TRIGGER ---
        document.getElementById('start-btn').addEventListener('click', () => {
            // Selected mission update from Dropdown
            const selMission = parseInt(missionSelectEl.value);
            saveState.currentMission = selMission;
            saveGame();

            menuOverlay.style.display = 'none';
            gameRunning = true;
            
            init3D();
            clock.getDelta(); // reset clock interval
            animate();
        });

        // Initial UI Draw
        updateUI();

    </script>
</body>
</html>
